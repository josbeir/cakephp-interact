{
  "name": "josbeir/cakephp-interact",
  "description": "Reactive server-rendered PHP islands for CakePHP.",
  "type": "cakephp-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "cakephp/cakephp": "^5.4"
  },
  "require-dev": {
    "cakephp/authentication": "^3.0",
    "cakephp/authorization": "^3.0",
    "cakephp/bake": "^3.8",
    "cakephp/mago-rules": "dev-main",
    "carthage-software/mago": "^1.59",
    "josbeir/cakephp-mercure": "^0.3.1",
    "phpunit/phpunit": "^12.5 || ^13.0",
    "rector/rector": "^2.8.1",
    "symfony/process": "^8.0"
  },
  "suggest": {
    "cakephp/authentication": "Use AuthenticationTrait for direct access to the application's authentication service. Install ^3.0 for CakePHP 5.",
    "cakephp/authorization": "Use AuthorizationTrait for optional policy checks and scopes in islands. Install ^3.0 for CakePHP 5.",
    "cakephp/bake": "Generate island classes and matching templates with bin/cake bake island. Install as a development dependency.",
    "josbeir/cakephp-mercure": "Mercure 1.x publishing and subscription authorization with the CakePHP 5 compatible package."
  },
  "autoload": {
    "psr-4": {
      "Interact\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Interact\\Test\\": "tests/",
      "TestApp\\": "tests/test_app/src/",
      "Commerce\\": "tests/Fixture/Rendering/Plugins/Commerce/src/",
      "Acme\\Catalog\\": "tests/Fixture/Rendering/Plugins/Catalog/src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": [
      "phpunit --coverage-clover=build/clover.xml",
      "@php scripts/check-coverage.php build/clover.xml"
    ],
    "analyze": "mago analyze",
    "lint": "mago lint",
    "format-check": "mago format --check",
    "format": "mago format",
    "lint-fix": "mago lint --fix --format-after-fix --fail-on-remaining",
    "rector": "rector process --dry-run",
    "rector-fix": [
      "rector process",
      "@format"
    ],
    "check": [
      "@test",
      "@analyze",
      "@lint",
      "@rector",
      "@format-check"
    ],
    "test-coverage-branches": "phpunit --path-coverage --coverage-text=build/php-branches.txt",
    "preview": [
      "Composer\\Config::disableProcessTimeout",
      "@php scripts/preview.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "extra": {
    "branch-alias": {
      "dev-main": "0.2.x-dev"
    }
  }
}
