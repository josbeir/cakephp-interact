{
  "name": "@josbeir/cakephp-interact",
  "version": "0.1.0",
  "description": "Reactive server-rendered PHP islands for CakePHP.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "build/js",
    "docs/public/branding/interact-mark.svg"
  ],
  "exports": {
    ".": {
      "types": "./build/js/index.d.ts",
      "import": "./build/js/index.js"
    }
  },
  "peerDependencies": {
    "alpinejs": "^3.15.0"
  },
  "dependencies": {
    "@alpinejs/morph": "^3.15.0",
    "@types/alpinejs": "^3.13.11"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.15.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/alpinejs__morph": "^3.13.5",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "alpinejs": "^3.15.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.60.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "4.1.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-js-coverage.mjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "check": "npm run typecheck && npm run lint && npm run format-check && npm test",
    "preview": "php -d opcache.enable=0 -S 127.0.0.1:8765 -t tests/test_app/webroot tests/test_app/webroot/index.php",
    "package:composer": "npm run build && node scripts/package-composer.mjs"
  }
}
