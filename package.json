{
  "name": "@josbeir/cakephp-interact",
  "version": "0.1.0",
  "description": "Reactive server-rendered PHP islands for CakePHP.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "files": [
    "build/js",
    "docs/public/branding/interact-mark.svg"
  ],
  "exports": {
    ".": {
      "types": "./build/js/index.d.ts",
      "import": "./build/js/index.js"
    }
  },
  "peerDependencies": {
    "alpinejs": "^3.17.4"
  },
  "dependencies": {
    "@alpinejs/morph": "^3.17.4",
    "@types/alpinejs": "^3.13.11",
    "eventsource-parser": "^4.1.2"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.4",
    "@playwright/test": "1.64.1",
    "@types/alpinejs__morph": "^3.13.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "alpinejs": "^3.17.4",
    "jsdom": "^27.4.0",
    "tom-select": "^2.6.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "vitepress": "2.0.0-alpha.20"
  },
  "scripts": {
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint --deny-warnings .",
    "format-check": "vp fmt --check .",
    "format": "vp fmt .",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage && node scripts/check-js-coverage.mjs",
    "test:browser": "playwright test",
    "build": "vp pack",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/check-docs.mjs",
    "check": "vp check && npm test",
    "package:composer": "npm run build && node scripts/package-composer.mjs"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  }
}
