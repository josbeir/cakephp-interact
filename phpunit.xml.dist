<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
    bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache"
    failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
    <testsuites><testsuite name="Interact"><directory>tests/TestCase</directory></testsuite></testsuites>
    <source><include><directory suffix=".php">src</directory></include></source>
    <coverage includeUncoveredFiles="true"/>
    <php><ini name="session.use_cookies" value="0"/><ini name="session.cache_limiter" value=""/></php>
</phpunit>
